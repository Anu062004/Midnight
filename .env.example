# Leave these blank to keep live model delivery disabled.
# Gemini is the active provider when GEMINI_API_KEY is set; otherwise OpenAI is used.
GEMINI_API_KEY=
# Example: gemini-2.5-flash (must match a model available to your Google AI project).
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# Set a Responses-compatible model available to your OpenAI project.
OPENAI_MODEL=
DATABASE_PATH=./data/workspace.sqlite
PORT=3000
# Copy the operator's authenticated user ID from Team & account after registering.
# Email is deliberately not used as operator authentication.
MIDNIGHT_OPERATOR_USER_ID=
MIDNIGHT_KEY_FILE=./data/midnight-operator.json
